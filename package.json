{
  "name": "security-health-checker",
  "private": false,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "sample-report": "node scripts/generate-sample-report.js",
    "prebuild": "node scripts/generate-sample-report.js",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "server:watch": "node --watch server/index.js",
    "dev:all": "concurrently -n web,api -c blue,green \"npm:dev\" \"npm:server:watch\"",
    "start": "npm run build && node server.js",
    "scan": "node cli/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "pdfkit": "^0.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "vite": "^5.4.8"
  },
  "description": "Open-source defensive website security health checker with web UI and Linux CLI.",
  "bin": {
    "security-health-checker": "cli/index.js"
  }
}
